        "def construct_M_Dirichlet(x):\n",
        "    dx = x[1] - x[0]\n",
        "    Nx = len(x)\n",
        "\n",
        "    M = (np.diag(np.ones(Nx-1), -1) - 2*np.diag(np.ones(Nx), 0) + np.diag(np.ones(Nx-1), 1)) / dx**2\n",
        "\n",
        "    # For Dirichlet: c₀ = a, c_N = b\n",
        "    M[0, :] = 0; M[0, 0] = 1/dx**2\n",
        "    M[-1, :] = 0; M[-1, -1] = 1/dx**2\n",
        "\n",
        "    return sp.csr_matrix(M)"
