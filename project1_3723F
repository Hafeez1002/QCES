        "def CNBC_N(x, t, kappa):\n",
        "    dt = t[1] - t[0]\n",
        "    Nx = len(x); Nt = len(t)\n",
        "\n",
        "    M = construct_M_Neumann(x)\n",
        "\n",
        "    # Crank-Nicolson matrices\n",
        "    I = sp.eye(Nx)\n",
        "    A = I - 0.5 * dt * kappa * M\n",
        "    B = I + 0.5 * dt * kappa * M\n",
        "\n",
        "    #getting the LU values because it's easier\n",
        "    A_lu = sp.linalg.splu(A)\n",
        "\n",
        "    c = np.zeros((Nx, Nt))\n",
        "    c[:, 0] = set_ics(x, kappa, 10)  #initial conditions like last time\n",
        "\n",
        "    for k in range(1, Nt):\n",
        "        rhs = B @ c[:, k-1]\n",
        "        c[:, k] = A_lu.solve(rhs)\n",
        "\n",
        "    return c"
