      "cell_type": "code",
      "source": [
        "# First contruct the Matrix with the boundary conditions of no flux at the boundaries\n",
        "#dc/ dx = 0 at boundaries\n",
        "def construct_M_Neumann(x):\n",
        "    dx = x[1] - x[0]\n",
        "    Nx = len(x)\n",
        "\n",
        "    # Standard second derivative matrix\n",
        "    M = (np.diag(np.ones(Nx-1), -1) - 2*np.diag(np.ones(Nx), 0) + np.diag(np.ones(Nx-1), 1)) / dx**2\n",
        "\n",
        "    # Apply Neumann BCs: dc/dx = 0 at both ends\n",
        "    # We also know dc / dc = c_1 - c_0 / dx so\n",
        "    # At left boundary: c_0 = c_1 (from finite difference approximation)\n",
        "    M[0, 0] = -1/dx**2\n",
        "    M[0, 1] = 1/dx**2\n",
        "\n",
        "    # At right boundary: c_N = c_{N-1}\n",
        "    M[-1, -1] = -1/dx**2\n",
        "    M[-1, -2] = 1/dx**2\n",
        "\n",
        "    return sp.csr_matrix(M)"
      ],
